{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "ClockSkewMinutes": 1,
    "UsedTokenStoreMinutes": 6,
    "Audience": "VelductServer",
    "ServerKeys": [
      "ЗАМЕНИТЕ_НА_РЕАЛЬНЫЙ_КЛЮЧ_МИН_32_СИМВОЛА"
    ]
  },

  "TransferOptions": {
    "Storage": {
      "DataDirectory": "/app/data",
      "TempDirectory": "/app/temp"
    },
    "Network": {
      "MaxCredits": 4,
      "NetworkPoolSize": 8,
      "ChunkSizeBytes": 4194304,
      "HeaderBufferSize": 65536,
      "MessagePayloadBufferSize": 262144,
      "SendChannelCapacity": 256,
      "CreditTimeoutSeconds": 60,
      "FileLockRetryDelayMs": 500
    },
    "Disk": {
      "MaxConcurrentDiskIoTasks": 4,
      "IoBufferSize": 1048576,
      "MoveRetryDelayMs": 500,
      "TarReadBufferSize": 2097152,
      "CreateTasksQueueCapacity": 100,
      "FinalizeTasksQueueCapacity": 100
    },
    "Sync": {
      "ScanBatchSize": 100,
      "DeleteRetryDelayMs": 500,
      "DeleteTimestampCleanupThreshold": 1000,
      "DeleteTimestampTtlMinutes": 5
    },
    "Broadcast": {
      "FlushIntervalMs": 200
    },
    "Archive": {
      "UnpackTaskTimeoutMs": 15000
    },
    "WebSocket": {
      "KeepAliveSeconds": 15,
      "SendRetryDelayMs": 100,
      "KestrelBufferOverhead": 4096
    }
  }
}
