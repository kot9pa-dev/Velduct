    "Disk": {
      "MaxConcurrentDiskIoTasks": 2,
      "IoBufferSize": 262144,
      "MoveRetryDelayMs": 250,
      "TarReadBufferSize": 524288,
      "CreateTasksQueueCapacity": 32,
      "FinalizeTasksQueueCapacity": 32
    },
    "Sync": {
      "ScanBatchSize": 100,
      "DeleteRetryDelayMs": 250,
      "DeleteTimestampCleanupThreshold": 100,
      "DeleteTimestampTtlMinutes": 2,
      "PullCoalescingMaxMs": 2500,
      "PullCoalescingIdleMs": 250
    },
    "Broadcast": {
      "FlushIntervalMs": 100
    },
    "Archive": {
      "UnpackTaskTimeoutMs": 5000
    },
    "WebSocket": {
      "KeepAliveSeconds": 10,
      "SendRetryDelayMs": 50,
      "KestrelBufferOverhead": 4096
    }
  }
}
