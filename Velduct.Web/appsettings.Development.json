{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Velduct": "Debug"
    }
  },
  "JwtSettings": {
    "ClockSkewMinutes": 1,
    "UsedTokenStoreMinutes": 6,
    "Audience": "VelductServer",
    "ServerKeys": [
      "ZAMENITE_NA_REALNYY_KLYUCH_MIN_32_SIMVOLA"
    ]
  },
  "TransferOptions": {
    "Storage": {
      "DataDirectory": "/app/data",
      "TempDirectory": "/app/temp"
    },
    "Network": {
      "MaxCredits": 4,
      "NetworkPoolSize": 6,
      "ChunkSizeBytes": 1048576,
      "HeaderBufferSize": 32768,
      "MessagePayloadBufferSize": 131072,
      "SendChannelCapacity": 4096,
      "CreditTimeoutSeconds": 15,
      "FileLockRetryDelayMs": 250
