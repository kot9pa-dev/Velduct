<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="/app/logs/nlog-internal.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>

    <target xsi:type="File"
            name="allfile"
            fileName="/app/logs/all/nlog-${shortdate}.log"
            archiveFileName="/app/logs/all/archives/nlog-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${level:uppercase=true} | ${longdate} | ${logger:shortName=true} | ${message} ${exception:format=ToString}" />

    <target xsi:type="File"
            name="errorfile"
            fileName="/app/logs/errors/nlog-error-${shortdate}.log"
            archiveFileName="/app/logs/errors/archives/nlog-error-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Sequence"
            maxArchiveFiles="14"
            layout="${level:uppercase=true} | ${longdate} | ${logger} | ${message} ${exception:format=ToString}" />

    <target xsi:type="ColoredConsole"
            name="console"
            detectConsoleAvailable="true">
      <layout>${level:uppercase=true} | ${date:format=dd/MM/yyyy HH\:mm\:ss} | ${logger:shortName=true} | ${message} ${exception:format=ToString}</layout>

      <highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Info"  foregroundColor="White" />
      <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="DarkRed" />
    </target>

    <target xsi:type="File"
            name="auditFile"
            fileName="/app/logs/audit/transfers-${shortdate}.log"
            archiveFileName="/app/logs/audit/archives/audit-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Sequence"
            maxArchiveFiles="60"
            layout="${longdate} | ${message}" />

  </targets>

  <rules>
    <logger name="TransferAudit" minlevel="Info" writeTo="auditFile,console" final="true" />
    <logger name="Microsoft.AspNetCore.Authentication.JwtBearer.*" maxlevel="Warn" final="true" />
    <logger name="Microsoft.AspNetCore.Authorization.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.Server.Kestrel*" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.Hosting.Diagnostics" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.Routing*" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.StaticFiles*" maxlevel="Info" final="true" />

    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="allfile" />
    <logger name="*" minlevel="Error" writeTo="errorfile" />
    <logger name="*" minlevel="Info" writeTo="console" />

  </rules>

</nlog>
